{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client"
    ]
    
  },
  "exclude": [
    "node_modules",
    "dist",
    "android",
    "backend/supabase/functions/**"
  ]
  
}
